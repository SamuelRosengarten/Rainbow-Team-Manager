# Copy to .env for local development. Never commit .env.
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# "true" shows the team passcode screen. Set it to "true" in production (Vercel).
VITE_REQUIRE_PASSCODE=false

# Optional: player stats endpoint (see docs/PLAYER_STATS.md). Without it the app works, with "Stats unavailable".
VITE_STATS_API_URL=
