# Copy to .env for local development. Never commit .env.
# Supabase -> Project Settings -> API: the Project URL and the anon public key.
# Never put the service_role key here, in Vercel or anywhere in this repo: it
# lives only in the steam-auth Edge Function (Supabase provides it there).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: player stats endpoint (see docs/PLAYER_STATS.md). Without it the app works, with "Stats unavailable".
VITE_STATS_API_URL=
